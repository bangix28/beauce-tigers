# Valeurs publiques du mode développement (npm run dev), versionnées.
# Les URL d'infrastructure (BFF) restent dans .env.local, non versionné.
# JAMAIS de secret ici : le Client Secret Discord ne vit que sur le serveur de l'API.

VITE_DISCORD_CLIENT_ID=1563985957898821632
# Identique au caractère près à celle déclarée chez Discord et à DISCORD_REDIRECT_URI
# côté api-bot : même schéma, même domaine, même chemin, pas de / final
VITE_DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
